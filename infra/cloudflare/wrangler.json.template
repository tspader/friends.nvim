{
  "name": "${worker_name}",
  "compatibility_date": "${compatibility_date}",
  "main": "src/worker.ts",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friends",
      "database_id": "${d1_id}",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GET_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
