{
  "name": "${worker_name}",
  "compatibility_date": "${compatibility_date}",
  "main": "src/index.ts",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friends",
      "database_id": "${d1_id}",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
